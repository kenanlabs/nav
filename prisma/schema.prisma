// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Workspace {
  id              String     @id @default(cuid())
  slug            String     @unique
  name            String
  description     String?
  // 展示覆盖项：为空时回退 SystemSettings 对应值
  siteName        String?    @map("site_name")
  siteDescription String?    @map("site_description")
  siteLogo        String?    @map("site_logo")
  favicon         String?
  // About 页内容覆盖项：为空时回退 SystemSettings.aboutContent
  aboutContent    String?    @map("about_content")
  isDefault       Boolean    @default(false) @map("is_default")
  // 未发布工作区对前台按「未匹配域名」处理（渲染默认工作区）
  isPublished     Boolean    @default(false) @map("is_published")
  order           Int        @default(0)
  domains         Domain[]
  categories      Category[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@map("Workspace")
}

model Domain {
  id          String    @id @default(cuid())
  // 规范化主机名：小写、无协议、无端口
  host        String    @unique
  isPrimary   Boolean   @default(false) @map("is_primary")
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@index([workspaceId])
  @@map("Domain")
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String
  icon        String?
  order       Int       @default(0)
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  sites       Site[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([workspaceId, slug])
  @@index([workspaceId])
  @@map("Category")
}

model Site {
  id               String    @id @default(cuid())
  name             String
  url              String
  description      String
  iconUrl          String?   @map("icon_url")
  submitterContact String?   @map("submitter_contact")
  submitterIp       String?  @map("submitter_ip")
  categoryId       String
  category         Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  isPublished      Boolean   @default(false)
  isPinned         Boolean   @default(false)
  order            Int       @default(0)
  detailContent    String?   @map("detail_content")
  hasDetail        Boolean   @default(false) @map("has_detail")
  // 测活（健康检测）结果，由管理后台手动触发写入
  healthStatus     String    @default("unknown") @map("health_status") // unknown | up | suspicious | down
  lastHttpStatus   Int?      @map("last_http_status")
  latencyMs        Int?      @map("latency_ms")
  lastCheckedAt    DateTime? @map("last_checked_at")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  visits           Visit[]
  screenshots      Screenshot[]

  @@index([categoryId])
  @@index([isPublished])
  @@index([isPinned])
  @@index([categoryId, isPublished])
  @@index([order])
  @@map("Site")
}

enum ScreenshotSource {
  URL
  UPLOAD
}

model Screenshot {
  id        String           @id @default(cuid())
  siteId    String
  site      Site             @relation(fields: [siteId], references: [id], onDelete: Cascade)
  source    ScreenshotSource
  url       String?
  data      String?
  mimeType  String?          @map("mime_type")
  order     Int              @default(0)
  createdAt DateTime         @default(now())

  @@index([siteId])
  @@map("Screenshot")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  avatar    String?
  role      UserRole @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum UserRole {
  ADMIN
}

model SystemSettings {
  id               String   @id @default("default") @map("id")
  siteName         String   @default("Conan Nav") @map("site_name")
  siteDescription  String   @default("简洁现代化的网址导航系统") @map("site_description")
  siteLogo         String?  @map("site_logo")
  favicon          String?  @map("favicon")
  pageSize         Int      @default(20) @map("page_size")
  // Footer settings
  showFooter        Boolean  @default(true) @map("show_footer")
  footerCopyright  String   @map("footer_copyright")  // 默认值由 seed.ts 动态生成
  footerLinks      Json     @default("[]") @map("footer_links")
  showAdminLink    Boolean  @default(true) @map("show_admin_link")
  // ICP filing settings (备案信息)
  showIcp          Boolean  @default(false) @map("show_icp")
  icpNumber        String?  @map("icp_number")
  icpLink          String?  @map("icp_link")
  // Visit tracking settings
  enableVisitTracking Boolean @default(true) @map("enable_visit_tracking")
  // Submission settings (网站收录设置)
  enableSubmission     Boolean  @default(true) @map("enable_submission")
  submissionMaxPerDay  Int     @default(3) @map("submission_max_per_day")
  // Site detail dialog (二级详情弹窗)
  enableSiteDetail     Boolean  @default(false) @map("enable_site_detail")
  // Poetry card (今日诗词卡片总开关)
  enablePoetry         Boolean  @default(true) @map("enable_poetry")
  // About page (关于页面总开关；内容按工作区覆盖，空则回退 aboutContent)
  enableAboutPage      Boolean  @default(false) @map("enable_about_page")
  aboutContent         String?  @map("about_content")
  // GitHub link
  githubUrl        String?  @map("github_url")
  // Default site language for visitors without a locale cookie (zh/en)
  defaultLanguage  String   @default("zh") @map("default_language")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("SystemSettings")
}

model Visit {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  ipAddress String?
  userAgent String?
  referer   String?
  visitedAt DateTime @default(now())

  @@index([siteId])
  @@index([visitedAt])
  @@index([siteId, visitedAt])
}
